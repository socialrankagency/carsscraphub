# Speed: compression + browser caching (works on Apache/LiteSpeed hosts; ignored elsewhere)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
ErrorDocument 404 /404.html

# Clean URLs (Apache/LiteSpeed): hide .html. GitHub Pages already serves /about for about.html on its own.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # /about.html -> /about (301)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteCond %{REQUEST_URI} !404\.html$
  RewriteRule ^ /%1 [R=301,L,NE]
  # /about -> about.html (internal)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
